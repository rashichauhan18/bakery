PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_DB_NAME=bakery
MONGODB_URI=PASTE_YOUR_MONGODB_ATLAS_CONNECTION_STRING_HERE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=4h
# Configure only in your private server/.env before running npm run create-admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
